AdvancedDiscoveryPool = PackedStringArray("prototype_u01", "prototype_u06", "prototype_u08", "prototype_u13", "prototype_u14", "prototype_u17", "prototype_u18", "prototype_u20", "prototype_u21", "prototype_u22", "prototype_u25")
