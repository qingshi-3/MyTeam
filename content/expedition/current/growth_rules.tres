[sub_resource type="Resource" id="benefit2"]
script = ExtResource("benefit")
Description = "雷爪每次原始普攻的额外目标上限由2提高至3，第三目标仍造成60%攻击伤害；单一目标没有额外命中。"
BattleLoadout = ExtResource("ascended2")

[sub_resource type="Resource" id="benefit7"]
script = ExtResource("benefit")
Description = "蓄意轰拳成功释放后，回复本次消耗怒劲20%的生命；打断不治疗、不返还怒劲。"
BattleLoadout = ExtResource("ascended7")

[sub_resource type="Resource" id="benefit19"]
script = ExtResource("benefit")
Description = "技能箭首次成功命中获得2层攻速，之后每次1层，最多7层；未命中不增加。"
BattleLoadout = ExtResource("ascended19")

[sub_resource type="Resource" id="benefit18"]
script = ExtResource("benefit")
Description = "完成第三次喷火后，在原扇区留下1.5秒余焰，每0.5秒造成20%攻击伤害。"
BattleLoadout = ExtResource("ascended18")

[sub_resource type="Resource" id="benefit11"]
script = ExtResource("benefit")
Description = "完整维持5秒换形治疗后，为该次实际接受治疗且仍存活的单位获得有效治疗量20%的护盾，持续4秒。"
BattleLoadout = ExtResource("ascended11")

[sub_resource type="Resource" id="benefit17"]
script = ExtResource("benefit")
Description = "扑击直接击杀常驻敌人后，在动作恢复结束返还30法力；每次施法最多一次。"
BattleLoadout = ExtResource("ascended17")

[sub_resource type="Resource" id="benefit21"]
script = ExtResource("benefit")
Description = "完整释放15道雷后返还40法力，中断不返还。"
BattleLoadout = ExtResource("ascended21")

[sub_resource type="Resource" id="benefit22"]
script = ExtResource("benefit")
Description = "第二发技能弹命中后，向主目标2格内另一名最近敌人弹射，造成60%法强伤害。"
BattleLoadout = ExtResource("ascended22")

[sub_resource type="Resource" id="display"]
script = ExtResource("display")
DisplayName = "升阶"
CompletedLabel = "已升阶"

