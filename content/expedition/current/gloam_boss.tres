[ext_resource type="Resource" path="res://content/expedition/current/v1_pools/reward_relic.tres" id="reward1"]
[sub_resource type="Resource" id="pool"]
script = ExtResource("pool")
StableId = "gloam_boss_enemies"
Kind = 2
ContentIds = PackedStringArray("v1_boss_furnace", "enemy_e33_field_medic_gloam_guard", "enemy_e32_wood_archer_gloam_guard", "enemy_e34_ambush_scout_gloam_guard")

[sub_resource type="Resource" id="formation"]
script = ExtResource("comp")
StableId = "gloam_boss_formation"
DisplayName = "守关阵容"
EnemyIds = PackedStringArray("v1_boss_furnace", "enemy_e33_field_medic_gloam_guard", "enemy_e32_wood_archer_gloam_guard", "enemy_e34_ambush_scout_gloam_guard")
Cells = Array[Vector2i]([Vector2i(6, 2), Vector2i(8, 1), Vector2i(9, 4), Vector2i(8, 4)])

[sub_resource type="Resource" id="phase"]
script = ExtResource("phase")
StableId = "gloam_boss_phase"
DisplayName = "熔炉守卫"
StartHealthRatio = 1.0
AbilityLoadout = ExtResource("loadout")

[sub_resource type="Resource" id="timeline"]
script = ExtResource("timeline")
StableId = "gloam_boss_timeline"
BossContentId = "v1_boss_furnace"
Phases = Array[Resource]([SubResource("phase")])

[sub_resource type="Resource" id="encounter"]
script = ExtResource("enc")
StableId = "gloam_boss_encounter"
NodeType = 6
TitlePattern = "守关 · 熔炉守卫"
EnemyPool = SubResource("pool")
FloorRulePool = ExtResource("floors")
BaseEnemyCount = 4
AddRegionIndexToCount = false
Compositions = Array[Resource]([SubResource("formation")])
LeadEnemyId = "v1_boss_furnace"
BossTimeline = SubResource("timeline")

[sub_resource type="Resource" id="reward"]
script = ExtResource("reward")
StableId = "gloam_boss_reward"
Gold = 18

Groups = Array[Resource]([ExtResource("reward0"), ExtResource("reward1")])
[resource]
script = ExtResource("script")
StableId = "gloam_boss_profile"
Encounter = SubResource("encounter")
CompositionId = "gloam_boss_formation"
FinalHealthMultiplier = 1
FinalDamageMultiplier = 1
OpeningCandidate = false
Reward = SubResource("reward")
