[gd_resource type="Resource" script_class="RunOfferDefinition" format=3]

[ext_resource type="Script" path="res://src/Project/RunOfferDefinition.cs" id="script"]
[ext_resource type="Script" path="res://src/Project/RunChoiceDefinition.cs" id="choice"]
[ext_resource type="Script" path="res://src/Project/RunOperationDefinition.cs" id="operation"]

[sub_resource type="Resource" id="safe_operation"]
script = ExtResource("operation")
Kind = 9
Amount = 3

[sub_resource type="Resource" id="risky_operation"]
script = ExtResource("operation")
Kind = 0
Amount = 6

[sub_resource type="Resource" id="safe_choice"]
script = ExtResource("choice")
StableId = "v1_event_v05_safe"
DisplayName = "揭示最近 3 处未知地点"
Description = "可预览揭示地点的实际敌阵或库存，不移动、不清除守军。"
Operations = Array[Resource]([SubResource("safe_operation")])

[sub_resource type="Resource" id="risky_choice"]
script = ExtResource("choice")
StableId = "v1_event_v05_risky"
DisplayName = "领取 6 金币"
Description = "获得 6 金币。"
SuccessChance = 1.0
Operations = Array[Resource]([SubResource("risky_operation")])
FailureOperations = Array[Resource]([])

[resource]
script = ExtResource("script")
StableId = "v1_event_v05"
Kind = 3
DisplayName = "斥候地图"
AllowSkip = false
Choices = Array[Resource]([SubResource("safe_choice"), SubResource("risky_choice")])
