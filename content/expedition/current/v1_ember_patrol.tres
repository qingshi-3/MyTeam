[gd_resource type="Resource" script_class="ExpeditionEncounterDefinition" format=3]
[ext_resource type="Script" path="res://src/Project/ExpeditionEncounterDefinition.cs" id="script"]
[ext_resource type="Script" path="res://src/Project/EncounterDefinition.cs" id="enc"]
[ext_resource type="Script" path="res://src/Project/EncounterCompositionDefinition.cs" id="comp"]
[ext_resource type="Script" path="res://src/Project/ContentPoolDefinition.cs" id="pool"]
[ext_resource type="Script" path="res://src/Project/RunRewardRecipeDefinition.cs" id="reward"]
[ext_resource type="Resource" path="res://content/expedition/current/floors.tres" id="floors"]

[sub_resource type="Resource" id="pool"]
script = ExtResource("pool")
StableId = "v1_ember_patrol_enemies"
Kind = 2
ContentIds = PackedStringArray("enemy_e31_iron_guard", "enemy_e32_wood_archer")

[sub_resource type="Resource" id="formation"]
script = ExtResource("comp")
StableId = "v1_ember_patrol_formation"
DisplayName = "巡逻阵容"
EnemyIds = PackedStringArray("enemy_e31_iron_guard", "enemy_e32_wood_archer")
Cells = Array[Vector2i]([Vector2i(7, 2), Vector2i(9, 3)])

[sub_resource type="Resource" id="encounter"]
script = ExtResource("enc")
StableId = "v1_ember_patrol_encounter"
NodeType = 0
TitlePattern = "铁卫巡逻"
EnemyPool = SubResource("pool")
FloorRulePool = ExtResource("floors")
BaseEnemyCount = 2
AddRegionIndexToCount = false
Compositions = Array[Resource]([SubResource("formation")])

[sub_resource type="Resource" id="reward"]
script = ExtResource("reward")
StableId = "v1_ember_patrol_reward"
Gold = 7

[resource]
script = ExtResource("script")
StableId = "v1_ember_patrol"
Encounter = SubResource("encounter")
CompositionId = "v1_ember_patrol_formation"
FinalHealthMultiplier = 1.4
FinalDamageMultiplier = 1.1
OpeningCandidate = true
Reward = SubResource("reward")
