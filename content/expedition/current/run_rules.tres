[gd_resource type="Resource" script_class="RunRulesDefinition" format=3]
[ext_resource type="Script" path="res://src/Project/RunRulesDefinition.cs" id="script"]
[ext_resource type="Resource" path="res://content/tactical-commands/definitions/tactical_rally.tres" id="rally"]
[ext_resource type="Resource" path="res://content/tactical-commands/definitions/tactical_time_stop.tres" id="time"]


[resource]
script = ExtResource("script")
StarterRosterHeroCount = 1
InitialUnlockedHeroCount = 2
InitialPopulation = 10
StarterTacticalCommands = [ExtResource("rally"), ExtResource("time")]
