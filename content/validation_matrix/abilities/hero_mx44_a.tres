DisplayName = "霜弦咏者·主动"
Description = "向当前敌人连续射出4支法术箭，每箭造成70%攻击伤害；每层蓄箭再提高8%伤害并消耗全部蓄箭。"
ActivationKind = 1
Trigger = 5
