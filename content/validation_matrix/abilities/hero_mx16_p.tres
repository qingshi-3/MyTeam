Magnitude = SubResource("op_4_magnitude")
Execution = SubResource("op_4_execution")

[sub_resource type="Resource" id="op_3_targeting"]
script = ExtResource("matrix_targeting")
Target = 0

[sub_resource type="Resource" id="op_3"]
script = ExtResource("operation")
Kind = 21
Effects = Array[ExtResource("operation")]([SubResource("op_4")])
Targeting = SubResource("op_3_targeting")

[resource]
script = ExtResource("ability")
StableId = "hero_mx16_p"
DisplayName = "守冢骑士·被动"
Description = "3格内临时友军阵亡时，自身获得18点护盾，最多保有65点，冷却1秒；自身每场首次阵亡时，为最近的存活友军提供35点护盾，持续3.5秒。"
ActivationKind = 1
Trigger = 1
ManaCost = 0
CooldownTicks = 1
MaxUses = 1
Operations = [SubResource("op_1"), SubResource("op_3")]
