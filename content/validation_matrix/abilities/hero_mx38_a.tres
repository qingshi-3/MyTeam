[resource]
script = ExtResource("ability")
StableId = "hero_mx38_a"
DisplayName = "余烬司魂者·主动"
Description = "对敌人最密集处2格内的敌人造成210%攻击伤害并施加1层余烬；每2层亡者余烬再增加1层余烬。"
ActivationKind = 1
Trigger = 5
