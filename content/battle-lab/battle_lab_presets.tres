[sub_resource type="Resource" id="default"]
script = ExtResource("preset")
DisplayName = "当前阵容 · 双方对战"
Description = "A队雷爪熊与寒羽射手，对战B队冲锋巨兽与炉喉火蝎；可直接开战或编辑布阵，不代表推荐阵容或平衡结论。"
PresetJson = "{\"SchemaVersion\":1,\"Mode\":1,\"CurrentPopulation\":10,\"Seed\":20261006,\"FloorRuleId\":\"rule_clear\",\"PrimaryHeroInstanceId\":\"lab-unit-1\",\"Units\":[{\"InstanceId\":\"lab-unit-1\",\"ContentId\":\"prototype_u02\",\"Side\":0,\"X\":2,\"Y\":2,\"Equipment\":[]},{\"InstanceId\":\"lab-unit-2\",\"ContentId\":\"prototype_u03\",\"Side\":0,\"X\":2,\"Y\":4,\"Equipment\":[]},{\"InstanceId\":\"lab-unit-3\",\"ContentId\":\"enemy_ee03_trample_brute\",\"Side\":1,\"X\":7,\"Y\":2,\"Equipment\":[]},{\"InstanceId\":\"lab-unit-4\",\"ContentId\":\"enemy_ee07_furnace_lizard\",\"Side\":1,\"X\":7,\"Y\":4,\"Equipment\":[]}],\"Relics\":[]}"

