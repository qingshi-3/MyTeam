[gd_scene format=3]
[ext_resource type="Script" path="res://src/Content/UnitContentRoot.cs" id="root"]
[ext_resource type="Resource" path="res://content/definitions/heroes/hero_hc38_grit_brawler.tres" id="definition"]
[ext_resource type="SpriteFrames" path="res://assets/donor-units/boss_solfist/frames.tres" id="frames"]
