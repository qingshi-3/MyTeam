[gd_resource type="Resource" script_class="EncounterDefinition" format=3]

[ext_resource type="Script" path="res://src/Project/EncounterDefinition.cs" id="1"]
[ext_resource type="Resource" path="res://content/project/pools/pool_ember_enemies.tres" id="2"]
[ext_resource type="Resource" path="res://content/project/pools/pool_ember_floor_rules.tres" id="3"]

[ext_resource type="Script" path="res://src/Project/EncounterCompositionDefinition.cs" id="composition"]

[sub_resource type="Resource" id="patrol"]
script = ExtResource("composition")
StableId = "ember_combat_patrol"
DisplayName = "前哨巡队"
MinLocalFloor = 0
MaxLocalFloor = 1
EnemyIds = PackedStringArray("enemy_rust_guard", "enemy_cutpurse", "enemy_crossbow")
Cells = Array[Vector2i]([Vector2i(7, 2), Vector2i(7, 3), Vector2i(9, 2)])

[sub_resource type="Resource" id="screen"]
script = ExtResource("composition")
StableId = "ember_combat_screen"
DisplayName = "盾后弩阵"
MinLocalFloor = 2
MaxLocalFloor = 4
EnemyIds = PackedStringArray("enemy_rust_guard", "enemy_rust_guard", "enemy_crossbow", "enemy_crossbow")
Cells = Array[Vector2i]([Vector2i(7, 2), Vector2i(7, 3), Vector2i(9, 2), Vector2i(9, 3)])

[sub_resource type="Resource" id="rush"]
script = ExtResource("composition")
StableId = "ember_combat_rush"
DisplayName = "双翼突袭"
MinLocalFloor = 2
MaxLocalFloor = 4
EnemyIds = PackedStringArray("enemy_rust_guard", "enemy_cutpurse", "enemy_cutpurse", "enemy_crossbow")
Cells = Array[Vector2i]([Vector2i(7, 2), Vector2i(7, 1), Vector2i(7, 4), Vector2i(9, 3)])

[resource]
script = ExtResource("1")
StableId = "encounter_ember_combat"
NodeType = 0
TitlePattern = "{region}遭遇战"
EnemyPool = ExtResource("2")
FloorRulePool = ExtResource("3")
BaseEnemyCount = 4
EnemyHealthMultiplier = 1
EnemyDamageMultiplier = 1
LocalHealthMultipliers = PackedFloat32Array(0.8, 0.95, 1.05, 1.2, 1.2)
LocalDamageMultipliers = PackedFloat32Array(0.8, 0.95, 1.05, 1.18, 1.18)
Compositions = [SubResource("patrol"), SubResource("screen"), SubResource("rush")]
