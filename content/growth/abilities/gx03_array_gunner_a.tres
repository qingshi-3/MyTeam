[gd_resource type="Resource" script_class="AbilityDefinition" format=3]
[ext_resource type="Script" path="res://src/Abilities/Authoring/AbilityDefinition.cs" id="ability"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixAbilityOperationSpec.cs" id="operation"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixTargetingParameters.cs" id="matrix_targeting"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixMagnitudeParameters.cs" id="matrix_magnitude"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixExecutionParameters.cs" id="matrix_execution"]

[sub_resource type="Resource" id="op_targeting"]
script = ExtResource("matrix_targeting")
Target = 0
Range = 7
Radius = 2
MaxTargets = 5

[sub_resource type="Resource" id="op_magnitude"]
script = ExtResource("matrix_magnitude")
Amount = 0.35
AttackRatio = 1.4

[sub_resource type="Resource" id="op_execution"]
script = ExtResource("matrix_execution")
Key = "gx03_array_gunner-shield-spent"
DurationTicks = 60
ContentId = "matrix_spirit_plague"

[sub_resource type="Resource" id="op"]
script = ExtResource("operation")
Kind = 10
Targeting = SubResource("op_targeting")
Magnitude = SubResource("op_magnitude")
Execution = SubResource("op_execution")

[sub_resource type="Resource" id="line_targeting"]
script = ExtResource("matrix_targeting")
Target = 1
Range = 8
MaxTargets = 5

[sub_resource type="Resource" id="line_magnitude"]
script = ExtResource("matrix_magnitude")
AttackRatio = 1.6
CounterRatio = 0.6

[sub_resource type="Resource" id="line_execution"]
script = ExtResource("matrix_execution")
Key = "gx03_array_gunner-shield-spent"
ConsumeCounter = true

[sub_resource type="Resource" id="line"]
script = ExtResource("operation")
Kind = 25
Targeting = SubResource("line_targeting")
Magnitude = SubResource("line_magnitude")
Execution = SubResource("line_execution")

[resource]
script = ExtResource("ability")
StableId = "gx03_array_gunner_a"
DisplayName = "GX03 阵列炮师·战术"
Description = "消耗35%当前护盾，对前方至多5名敌人发射贯穿射线。"
ActivationKind = 1
Trigger = 5
ManaCost = 70
CooldownTicks = 1
Operations = [SubResource("op"), SubResource("line")]