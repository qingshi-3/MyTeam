[gd_resource type="Resource" script_class="AbilityDefinition" format=3]
[ext_resource type="Script" path="res://src/Abilities/Authoring/AbilityDefinition.cs" id="ability"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixAbilityOperationSpec.cs" id="operation"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixTargetingParameters.cs" id="matrix_targeting"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixMagnitudeParameters.cs" id="matrix_magnitude"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixExecutionParameters.cs" id="matrix_execution"]
[ext_resource type="Script" path="res://src/Abilities/Authoring/MatrixReactionParameters.cs" id="matrix_reaction"]

[sub_resource type="Resource" id="gain_targeting"]
script = ExtResource("matrix_targeting")
Target = 0

[sub_resource type="Resource" id="gain_magnitude"]
script = ExtResource("matrix_magnitude")
Amount = 16

[sub_resource type="Resource" id="gain_execution"]
script = ExtResource("matrix_execution")
Attribute = 0

[sub_resource type="Resource" id="gain"]
script = ExtResource("operation")
Kind = 29
Targeting = SubResource("gain_targeting")
Magnitude = SubResource("gain_magnitude")
Execution = SubResource("gain_execution")

[sub_resource type="Resource" id="reaction_targeting"]
script = ExtResource("matrix_targeting")
Target = 0
TargetCondition = 8

[sub_resource type="Resource" id="reaction_reaction"]
script = ExtResource("matrix_reaction")
Event = 9
SourceRelation = 1
TargetRelation = 4
OncePerBattle = true

[sub_resource type="Resource" id="reaction"]
script = ExtResource("operation")
Kind = 18
Effects = Array[ExtResource("operation")]([SubResource("gain")])
Targeting = SubResource("reaction_targeting")
Reaction = SubResource("reaction_reaction")

[resource]
script = ExtResource("ability")
StableId = "hero_mx01_permanent_frost_growth"
DisplayName = "冻土积层"
Description = "每场首次成功冻结敌人后，永久获得16点最大生命；本场立即生效。"
ActivationKind = 1
Trigger = 1
MaxUses = 1
Operations = [SubResource("reaction")]