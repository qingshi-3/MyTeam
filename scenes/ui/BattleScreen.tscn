[node name="CollisionToggle" type="Button" parent="Margin/Layout/ViewControls"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CompactButton"
toggle_mode = true
text = "○ 碰撞"
tooltip_text = "实线为真实身体；虚线为空中投影，紫色叉圈为预留落点。地形显示完整阻挡格。\n开启时角色位置按战斗步对齐判定；暂停后可精确检查。点选单位切换观察，详情仍可从单位按钮打开。"

[node name="AttackRangeToggle" type="Button" parent="Margin/Layout/ViewControls"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CompactButton"
toggle_mode = true
text = "◎ 普攻范围"
tooltip_text = "黄色虚线为选中单位的身体半径＋普攻射程，触及目标身体即满足距离。连线数字为身体边缘间距与普攻射程；受地形阻挡时单独标记。\n只表示普攻空间条件，仍需满足前摇、冷却、控制等规则；技能范围各自独立。开启时点选单位只切换观察。"

