[gd_scene format=3]

[node name="TowerScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 70
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 70
theme_override_constants/margin_bottom = 40

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "高塔路线"

[node name="RunInfo" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "第 1 层"

[node name="RosterInfo" type="Label" parent="Margin/Layout"]
layout_mode = 2
autowrap_mode = 2
text = "军团"

[node name="RouteHint" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "选择下一处塔层节点"

[node name="Choices" type="VBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="AbandonButton" type="Button" parent="Margin/Layout"]
custom_minimum_size = Vector2(180, 50)
layout_mode = 2
size_flags_horizontal = 8
text = "放弃本次征程"
