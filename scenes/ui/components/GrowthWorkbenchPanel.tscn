[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/UI/GrowthWorkbenchPanel.cs" id="1"]

[node name="GrowthWorkbenchPanel" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 10
script = ExtResource("1")

[node name="Inventory" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"WorkbenchSubtitle"
text = "通用材料 0 · 研究 0"

[node name="PhaseHint" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 2

[node name="GrowthRules" type="FoldableContainer" parent="."]
layout_mode = 2
focus_mode = 2
title = "成长规则"
folded = true
theme_type_variation = &"BattleLabFold"

[node name="Rules" type="Label" parent="GrowthRules"]
layout_mode = 2
text = "生产按英雄初始属性计算并逐次累加，成长仅在本局有效。进入节点时，生产者与受益者需要已经上阵；满足条件后，战斗中阵亡不会取消本次收益。最终节点不产出。法术在战斗正式开始时消耗，预览与整备不会消耗库存。"
autowrap_mode = 2
theme_type_variation = &"SecondaryLabel"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 3
follow_focus = true

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

